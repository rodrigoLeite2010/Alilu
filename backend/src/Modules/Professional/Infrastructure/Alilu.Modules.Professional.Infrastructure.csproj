<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\Alilu.Modules.Professional.Domain.csproj" />
    <ProjectReference Include="..\Application\Alilu.Modules.Professional.Application.csproj" />

    <!--
      Referencia o Alilu.Infrastructure da raiz para usar o AliluDbContext
      compartilhado — mesma decisão dos módulos Identity/Condominium/
      Resident (ver Alilu.Modules.Resident.Infrastructure.csproj e
      ARCHITECTURE.md). As configurações de entidade deste módulo são
      descobertas em tempo de execução via reflexão, não por referência de
      projeto.
    -->
    <ProjectReference Include="..\..\..\Infrastructure\Alilu.Infrastructure\Alilu.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pacotes NuGet externos. Este container de build não tem acesso à
      internet/NuGet.org, então a restauração destes pacotes específicos
      deve ser feita na máquina do desenvolvedor (`dotnet restore`), onde
      funcionará normalmente. Veja o README para detalhes.
    -->

    <!-- Necessário para IEntityTypeConfiguration<T> / EntityTypeBuilder<T> usados nas configurações de mapeamento EF Core. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />

    <!-- IServiceCollection / IConfiguration usados em DependencyInjection.cs (AddProfessionalModule). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.*" />

    <!--
      Etapa 17 (pedido 1 de Rodrigo — "convidar um prestador via
      WhatsApp/SMS/e-mail"): AddHttpClient/IHttpClientFactory usados em
      DependencyInjection.cs para os senders reais (TwilioWhatsAppSender/
      TwilioSmsSender/SendGridEmailSender) — mesmo pacote já usado pelo
      módulo Notifications (ExpoPushNotificationSender, Etapa 11). Traz
      Microsoft.Extensions.Logging.Abstractions transitivamente (ILogger<T>
      usado por esses senders e pelos fakes de log).
    -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
  </ItemGroup>

</Project>
