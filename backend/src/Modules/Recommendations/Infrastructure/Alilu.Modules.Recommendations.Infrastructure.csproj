<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\Alilu.Modules.Recommendations.Domain.csproj" />
    <ProjectReference Include="..\Application\Alilu.Modules.Recommendations.Application.csproj" />

    <!--
      Referencia o Alilu.Infrastructure da raiz para usar o AliluDbContext
      compartilhado — mesma decisão dos demais módulos (ver
      Alilu.Modules.Reviews.Infrastructure.csproj e ARCHITECTURE.md). As
      configurações de entidade deste módulo são descobertas em tempo de
      execução via reflexão, não por referência de projeto.
    -->
    <ProjectReference Include="..\..\..\Infrastructure\Alilu.Infrastructure\Alilu.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pacotes NuGet externos. Este container de build não tem acesso à
      internet/NuGet.org, então a restauração destes pacotes específicos
      deve ser feita na máquina do desenvolvedor (`dotnet restore`), onde
      funcionará normalmente. Veja o README para detalhes.
    -->

    <!-- Necessário para IEntityTypeConfiguration<T> / EntityTypeBuilder<T> usados em RecommendationConfiguration.cs, e para DbUpdateException em UnitOfWork.cs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />

    <!--
      Necessário para PostgresException (SqlState "40001" — falha de
      serialização) em UnitOfWork.cs — CORREÇÃO Etapa 14 (auditoria):
      "não permitir spam ilimitado" também precisa da transação Serializable,
      mesmo motivo do módulo Scheduling (ver ARCHITECTURE.md, "Etapa 14").
      Já chegaria transitivamente via Alilu.Infrastructure, mas fica
      explícito aqui porque o tipo é usado diretamente neste projeto.
    -->
    <PackageReference Include="Npgsql" Version="8.0.*" />

    <!-- IServiceCollection / IConfiguration usados em DependencyInjection.cs (AddRecommendationsModule). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.*" />
  </ItemGroup>

</Project>
