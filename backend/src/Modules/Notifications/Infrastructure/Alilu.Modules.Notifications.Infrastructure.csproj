<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\Alilu.Modules.Notifications.Domain.csproj" />
    <ProjectReference Include="..\Application\Alilu.Modules.Notifications.Application.csproj" />

    <!--
      Referencia o Alilu.Infrastructure da raiz para usar o AliluDbContext
      compartilhado — mesma decisão dos demais módulos (ver
      Alilu.Modules.Recommendations.Infrastructure.csproj e ARCHITECTURE.md).
      As configurações de entidade deste módulo são descobertas em tempo de
      execução via reflexão, não por referência de projeto.
    -->
    <ProjectReference Include="..\..\..\Infrastructure\Alilu.Infrastructure\Alilu.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pacotes NuGet externos. Este container de build não tem acesso à
      internet/NuGet.org, então a restauração destes pacotes específicos
      deve ser feita na máquina do desenvolvedor (`dotnet restore`), onde
      funcionará normalmente. Veja o README para detalhes.
    -->

    <!-- Necessário para IEntityTypeConfiguration<T> / EntityTypeBuilder<T> usados em NotificationConfiguration.cs/DeviceTokenConfiguration.cs, e para DbUpdateException em UnitOfWork.cs. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />

    <!--
      Necessário para PostgresException (SqlState "23505" — violação de
      unicidade) em UnitOfWork.cs — CORREÇÃO Etapa 14 (auditoria): "não
      enviar notificações duplicadas" precisa do índice único no banco como
      rede de segurança contra a corrida da checagem em memória (ver
      ARCHITECTURE.md, "Etapa 14"). Já chegaria transitivamente via
      Alilu.Infrastructure, mas fica explícito aqui porque o tipo é usado
      diretamente neste projeto.
    -->
    <PackageReference Include="Npgsql" Version="8.0.*" />

    <!-- IServiceCollection / IConfiguration usados em DependencyInjection.cs (AddNotificationsModule). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.*" />

    <!-- AddHttpClient<TClient, TImplementation> usado em DependencyInjection.cs para registrar ExpoPushNotificationSender ("React Native: Utilizar Expo Notifications" — o envio server-side chama a API HTTP de push do Expo). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
  </ItemGroup>

</Project>
