# URL pública do site, usada para metadata (canonical, Open Graph, sitemap).
# Em produção deve ser https://alilu.com.br
NEXT_PUBLIC_SITE_URL=https://alilu.com.br

# ---------------------------------------------------------------------------
# Módulo de publicação automática no Instagram (Fase 3)
#
# NENHUM valor abaixo é real — são só os NOMES das variáveis que a aplicação
# espera. Preencha-os na Vercel (Project Settings → Environment Variables) e,
# para rodar localmente, num .env.local que NUNCA deve ser commitado (já
# está no .gitignore). Veja o guia de configuração manual para o passo a
# passo completo de onde obter cada valor.
# ---------------------------------------------------------------------------

# Banco de dados Postgres. A Vercel migrou o antigo "Vercel Postgres" para
# ser um add-on nativo da Neon, disponível em Storage → Create Database →
# escolha "Neon" (ou, se preferir, conecte via Vercel Marketplace). Ao
# conectar o banco ao projeto, a Vercel preenche esta variável sozinha. Para
# rodar localmente, copie o valor de "Connection string" no painel do banco
# (formato postgres://usuario:senha@host/banco?sslmode=require).
DATABASE_URL=

# Storage de mídia (Vercel Blob). Gerado automaticamente pela Vercel quando
# você cria um Blob Store (Storage → Create → Blob) e o conecta ao projeto.
BLOB_READ_WRITE_TOKEN=

# Chave usada para criptografar (AES-256-GCM) o access token do Instagram
# antes de gravar no banco. Gere UMA VEZ com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# e guarde só como variável de ambiente (nunca no código, nunca no
# frontend). Trocar essa chave invalida todos os tokens já criptografados —
# seria preciso reconectar todas as contas.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Segredo usado para assinar a sessão do NextAuth. Gere com:
#   npx auth secret
# ou
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Login com Google — criar em https://console.cloud.google.com/apis/credentials
# (tipo "ID do cliente OAuth", aplicativo Web). A URI de redirecionamento
# autorizada deve ser: https://alilu.com.br/api/auth/callback/google
# (e, para testar localmente: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Envio do código de login por e-mail (OTP) — conta gratuita em
# https://resend.com. Depois de verificar um domínio (ou usar o domínio de
# testes deles), gere uma API key em Resend → API Keys.
RESEND_API_KEY=
# E-mail remetente dos códigos de login, ex.: "ALILU <login@alilu.com.br>"
# (precisa ser de um domínio verificado no Resend).
RESEND_FROM_EMAIL=
# Nome novo e preferido do remetente (vale para login e agenda). Se vazio,
# usa RESEND_FROM_EMAIL. Ex.: "Alilu <nao-responda@alilu.com.br>"
EMAIL_FROM=
# Opcional: endereço de resposta (Reply-To), ex.: contato@alilu.com.br
EMAIL_REPLY_TO=
# Segredo de assinatura do webhook (Resend → Webhooks → seu endpoint →
# Signing secret, começa com "whsec_"). Sem ele o webhook recusa tudo.
RESEND_WEBHOOK_SECRET=
# Validade do código de login em minutos (padrão 10, máximo 60).
LOGIN_CODE_EXPIRATION_MINUTES=

# App do Instagram (Meta for Developers → seu app → Instagram → API setup
# with Instagram login). NUNCA commitar os valores reais — só os nomes
# ficam aqui. O App ID e o App Secret vêm do painel do app; o Redirect URI
# configurado lá deve ser https://alilu.com.br/api/instagram/oauth/callback.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcional. redirect_uri do login do Instagram. Se vazio: em produção usa
# NEXT_PUBLIC_SITE_URL (ou https://alilu.com.br) + /api/instagram/oauth/callback;
# em desenvolvimento usa a origem local (http://localhost:3000/...).
# Precisa ser IDÊNTICO ao cadastrado no Meta Developers. Nunca localhost em produção.
INSTAGRAM_OAUTH_REDIRECT_URI=
# Opcional. Segredo para assinar o "state" do OAuth (se vazio, usa AUTH_SECRET).
INSTAGRAM_OAUTH_STATE_SECRET=

# Agendador de publicações (ver docs/instagram-scheduler.md).
# O disparador (cron-job.org, GitHub Actions, Vercel Cron...) chama
#   GET ou POST https://alilu.com.br/api/cron/instagram-publish
# com o header:  Authorization: Bearer <segredo>
# Basta UM dos dois abaixo (mínimo 16 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRON_SECRET é o nome que a Vercel Cron envia automaticamente, se um dia
# for usada; INSTAGRAM_SCHEDULER_SECRET serve para disparadores externos.
INSTAGRAM_SCHEDULER_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------------------
# Piloto Automático de Conteúdo (ver docs/content-automation.md)
#
# Este módulo NUNCA fala com a Meta diretamente — ele só gera conteúdo com
# IA e cria/agenda publicações em instagram_posts; quem publica continua
# sendo o agendador acima. Tem seu PRÓPRIO disparador de cron, separado do
# de publicação (ver docs/content-automation.md, seção "Como ativar").
# ---------------------------------------------------------------------------

# Provedor de IA usado para gerar posts e Reels. Única opção disponível
# nesta etapa: "anthropic". Deixe em branco (ou omita) para usar o padrão.
CONTENT_AI_PROVIDER=anthropic

# Chave de API do provedor escolhido acima. Para "anthropic", gere em
# https://console.anthropic.com/settings/keys. Sem esta variável (e sem
# CONTENT_AI_MODEL), nenhuma automação consegue ser ativada — a tela mostra
# o erro explicando o que falta.
CONTENT_AI_API_KEY=

# Identificador do modelo do provedor escolhido, ex.: claude-sonnet-4-5.
# Consulte a documentação do provedor para a lista de modelos disponíveis.
CONTENT_AI_MODEL=

# Disparador do cron de GERAÇÃO (diferente do de publicação acima):
#   GET ou POST https://alilu.com.br/api/cron/content-automation
# com o header:  Authorization: Bearer <segredo>
# Opcional — se não for definido, o cron de geração aceita os mesmos
# segredos do agendador de publicação (INSTAGRAM_SCHEDULER_SECRET ou
# CRON_SECRET) acima. Defina esta variável só se quiser um segredo dedicado
# (mínimo 16 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTENT_AUTOMATION_CRON_SECRET=

# ---------------------------------------------------------------------------
# Assinatura do Piloto Automático de Conteúdo (Asaas)
#
# SOMENTE o Piloto Automático (geração com IA + postagem automática) é
# pago — o resto do Alilu continua 100% gratuito. Regra: 7 dias de teste
# grátis (até 3 automações/dia), depois R$ 19,00/mês via assinatura
# recorrente no Asaas. O acesso só é liberado quando o Webhook confirma o
# pagamento — nunca pelo redirect de volta do navegador.
#
# Comece pelo SANDBOX (api-sandbox.asaas.com) e só troque para produção
# depois de testar pagamento, renovação, atraso, cancelamento e o
# Webhook, como a própria documentação do Asaas recomenda.
# ---------------------------------------------------------------------------

# Chave de API do Asaas (Sandbox ou produção, conforme ASAAS_BASE_URL
# abaixo). Gere em Configurações > Integrações > API no painel do Asaas
# (sandbox.asaas.com ou www.asaas.com). Nunca compartilhe nem logue este
# valor.
ASAAS_API_KEY=

# URL base da API do Asaas. Use o Sandbox para desenvolver/testar:
#   https://api-sandbox.asaas.com/v3
# E só troque para produção depois de validar todo o fluxo:
#   https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Token de autenticação do Webhook — você mesmo escolhe esse valor (32 a
# 255 caracteres) e cadastra ele no painel do Asaas ao configurar o
# Webhook (Configurações > Integrações > Webhooks), junto com a URL:
#   https://alilu.com.br/api/billing/asaas-webhook
# e os eventos: PAYMENT_CONFIRMED, PAYMENT_RECEIVED, PAYMENT_OVERDUE,
# SUBSCRIPTION_DELETED, SUBSCRIPTION_INACTIVATED e — para a compra de
# Créditos de IA (docs/ai-video.md) — PAYMENT_REFUNDED,
# PAYMENT_CHARGEBACK_REQUESTED e PAYMENT_DELETED. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ASAAS_WEBHOOK_TOKEN=

# E-mails com acesso liberado ao Piloto Automático, sem limite diário e sem
# cobrança/assinatura no Asaas. Separe múltiplos e-mails por vírgula.
# Útil para dono/admin/testes internos, ex.: dono@alilu.com.br
AUTOMATION_BILLING_EXEMPT_EMAILS=

# ---------------------------------------------------------------------------
# Apoio/doação via Pix (rodapé + botão flutuante "Apoie o Alilu")
#
# Contribuição totalmente opcional, de valor livre (o doador escolhe o
# valor no próprio app do banco) — nunca bloqueia nenhuma ferramenta do
# site. NENHUM valor abaixo é real — só os NOMES das variáveis.
# ---------------------------------------------------------------------------

# Liga/desliga a área de doação inteira (rodapé + botão flutuante + modal).
# "false" desliga; qualquer outro valor (ou a variável ausente) mantém
# ligado — mas mesmo ligada, a doação só aparece de fato se as três
# variáveis abaixo também estiverem preenchidas (sem elas não dá pra montar
# um payload Pix válido).
NEXT_PUBLIC_DONATION_ENABLED=true

# Chave Pix que recebe as doações (qualquer tipo: aleatória, e-mail,
# telefone ou CPF/CNPJ). É pública por natureza — aparece na tela para
# quem for doar — mas ainda assim fica só nesta variável, nunca hardcoded
# em componente algum (ver lib/donation/config.ts).
NEXT_PUBLIC_PIX_KEY=

# Nome do recebedor exatamente como cadastrado no banco para essa chave
# Pix — entra no payload do QR Code (campo obrigatório do padrão BR Code).
# Sem acentuação, até 25 caracteres.
NEXT_PUBLIC_PIX_RECEIVER_NAME=

# Cidade do recebedor cadastrada no banco para essa chave Pix — também
# obrigatória no payload do QR Code. Sem acentuação, até 15 caracteres.
NEXT_PUBLIC_PIX_RECEIVER_CITY=

# ---------------------------------------------------------------------------
# Imagem para vídeo com IA + Créditos de IA (ver docs/ai-video.md)
# ---------------------------------------------------------------------------

# Chave da API de desenvolvedor da Runway (dev.runwayml.com). SÓ no
# servidor — nunca com prefixo NEXT_PUBLIC_ e nunca logada.
RUNWAYML_API_SECRET=

# Chave da API do fal.ai (fal.ai/dashboard/keys) — usada pela qualidade
# Econômica (Wan 2.2). SÓ no servidor — nunca com prefixo NEXT_PUBLIC_.
FAL_KEY=

# Segredo (≥16 caracteres) do cron externo que chama /api/cron/ai-video
# a cada 1 minuto (Authorization: Bearer <segredo>). Opcional: se vazio,
# usa CRON_SECRET ou INSTAGRAM_SCHEDULER_SECRET.
AI_VIDEO_CRON_SECRET=

# E-mails (separados por vírgula) com acesso a /admin/ia/precificacao e
# /admin/ia/custos. Vazio = ninguém é admin.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Vídeos > Importar do Instagram (ver docs/instagram-import.md)
# ---------------------------------------------------------------------------

# Token da API da Apify (console.apify.com → Settings → API & Integrations).
# SÓ no servidor. Usado para resolver links PÚBLICOS do Instagram.
APIFY_TOKEN=

# Opcional: outro Actor da Apify com a mesma entrada/saída (padrão:
# snapinsta~instagram-downloader-api).
APIFY_INSTAGRAM_ACTOR=

# ---------------------------------------------------------------------------
# Limpeza automática do Vercel Blob (ver docs/storage-cleanup.md)
# ---------------------------------------------------------------------------

# Opcional (≥16 caracteres): segredo do cron diário GET /api/cron/storage-cleanup.
# Sem ele, usa CRON_SECRET ou INSTAGRAM_SCHEDULER_SECRET.
STORAGE_CLEANUP_CRON_SECRET=

# Agenda — segredo opcional e dedicado para o cron de lembretes
# (GET /api/cron/agenda-reminders, a cada 1 minuto). Sem ele, usa
# CRON_SECRET ou INSTAGRAM_SCHEDULER_SECRET. Mínimo 16 caracteres.
AGENDA_CRON_SECRET=

# --- Admin: custo de IA de texto (opcional) ----------------------------------
# Preço do modelo de CONTENT_AI_MODEL em US$ por MILHÃO de tokens (entrada e
# saída), conforme a tabela de preços do provedor. Só alimenta o painel
# /admin/assinaturas (custo e margem em R$); sem elas o painel mostra apenas
# tokens e chamadas. Nunca é cobrado do usuário por token.
CONTENT_AI_INPUT_USD_PER_MTOK=
CONTENT_AI_OUTPUT_USD_PER_MTOK=

# ---------------------------------------------------------------------------
# Analytics (PostHog Cloud) — ver docs/analytics.md
# ---------------------------------------------------------------------------

# Chave PÚBLICA do projeto (Project settings → Project API key, "phc_..."). Vai para o navegador.
NEXT_PUBLIC_POSTHOG_KEY=
# Host de ingestão: US https://us.i.posthog.com · UE https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# SÓ no servidor (nunca NEXT_PUBLIC_): chave pessoal com escopo "Query: read" e o Project ID (número).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Opcional: host da API privada (padrão derivado do host acima: us.posthog.com / eu.posthog.com).
POSTHOG_API_HOST=
