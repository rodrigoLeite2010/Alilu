# URL pública do site, usada para metadata (canonical, Open Graph, sitemap).
# Em produção deve ser https://alilu.com.br
NEXT_PUBLIC_SITE_URL=https://alilu.com.br

# ---------------------------------------------------------------------------
# Módulo de publicação automática no Instagram (Fase 3)
#
# NENHUM valor abaixo é real — são só os NOMES das variáveis que a aplicação
# espera. Preencha-os na Vercel (Project Settings → Environment Variables) e,
# para rodar localmente, num .env.local que NUNCA deve ser commitado (já
# está no .gitignore). Veja o guia de configuração manual para o passo a
# passo completo de onde obter cada valor.
# ---------------------------------------------------------------------------

# Banco de dados Postgres. A Vercel migrou o antigo "Vercel Postgres" para
# ser um add-on nativo da Neon, disponível em Storage → Create Database →
# escolha "Neon" (ou, se preferir, conecte via Vercel Marketplace). Ao
# conectar o banco ao projeto, a Vercel preenche esta variável sozinha. Para
# rodar localmente, copie o valor de "Connection string" no painel do banco
# (formato postgres://usuario:senha@host/banco?sslmode=require).
DATABASE_URL=

# Storage de mídia (Vercel Blob). Gerado automaticamente pela Vercel quando
# você cria um Blob Store (Storage → Create → Blob) e o conecta ao projeto.
BLOB_READ_WRITE_TOKEN=

# Chave usada para criptografar (AES-256-GCM) o access token do Instagram
# antes de gravar no banco. Gere UMA VEZ com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# e guarde só como variável de ambiente (nunca no código, nunca no
# frontend). Trocar essa chave invalida todos os tokens já criptografados —
# seria preciso reconectar todas as contas.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Segredo usado para assinar a sessão do NextAuth. Gere com:
#   npx auth secret
# ou
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Login com Google — criar em https://console.cloud.google.com/apis/credentials
# (tipo "ID do cliente OAuth", aplicativo Web). A URI de redirecionamento
# autorizada deve ser: https://alilu.com.br/api/auth/callback/google
# (e, para testar localmente: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Envio do código de login por e-mail (OTP) — conta gratuita em
# https://resend.com. Depois de verificar um domínio (ou usar o domínio de
# testes deles), gere uma API key em Resend → API Keys.
RESEND_API_KEY=
# E-mail remetente dos códigos de login, ex.: "ALILU <login@alilu.com.br>"
# (precisa ser de um domínio verificado no Resend).
RESEND_FROM_EMAIL=

# App do Instagram (Meta for Developers → seu app → Instagram → API setup
# with Instagram login). NUNCA commitar os valores reais — só os nomes
# ficam aqui. O App ID e o App Secret vêm do painel do app; o Redirect URI
# configurado lá deve ser https://alilu.com.br/api/instagram/oauth/callback.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Agendador de publicações (ver docs/instagram-scheduler.md).
# O disparador (cron-job.org, GitHub Actions, Vercel Cron...) chama
#   GET ou POST https://alilu.com.br/api/cron/instagram-publish
# com o header:  Authorization: Bearer <segredo>
# Basta UM dos dois abaixo (mínimo 16 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRON_SECRET é o nome que a Vercel Cron envia automaticamente, se um dia
# for usada; INSTAGRAM_SCHEDULER_SECRET serve para disparadores externos.
INSTAGRAM_SCHEDULER_SECRET=
CRON_SECRET=
